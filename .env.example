# Telegram Bot Configuration
# 1. Talk to @BotFather on Telegram, type /newbot, and paste the API token below:
TELEGRAM_BOT_TOKEN=

# 2. Talk to @userinfobot on Telegram to get your numeric Chat ID:
TELEGRAM_CHAT_ID=

# Kotak Neo API Configuration (Leave blank for Paper Trading mode)
# Generate from: Kotak Neo App -> More -> Trade API (or https://neoapi.kotaksecurities.com)
KOTAK_CONSUMER_KEY=
KOTAK_ACCESS_TOKEN=
KOTAK_UCC=
KOTAK_MOBILE_NUMBER=
KOTAK_TOTP_SECRET=
